# --- Supabase (Project Settings > API) ---
# Public values: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Single-user lock ---
# Only this email may use the app, even if another Supabase user exists.
ADMIN_EMAIL=you@example.com

# --- Optional: HubSpot CRM source adapter (free HubSpot CRM, private app token) ---
# Server-only. Never prefix with NEXT_PUBLIC_. Leave empty to keep the adapter disconnected.
HUBSPOT_ACCESS_TOKEN=
